close-tray = Close to tray
close-quit = Quit the app
close-tray-explanation = The window closes and the proxies keep running in the tray.
close-quit-explanation = Quitting stops every running profile and exits ManyProxy.
accent-blue = Blue
accent-indigo = Indigo
accent-violet = Violet
accent-magenta = Magenta
accent-rose = Rose
accent-teal = Teal
accent-amber = Amber
corners-auto = Auto
corners-rounded = Rounded
corners-small = Small
corners-square = Square
corners-auto-explanation = Follow the Windows 11 frame default.
corners-rounded-explanation = Round the window's outer corners.
corners-small-explanation = Use the smaller Windows 11 corner radius.
corners-square-explanation = Square off the window's outer corners.
test-scope-running = Every running endpoint
test-scope-checked = Checked endpoints only
